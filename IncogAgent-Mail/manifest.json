{
  "manifest_version": 3,
  "name": "IncogAgent Mail - AI-Powered Privacy Guardian for Gmail",
  "author": "Copyright (c) 2026 IncogAgent Team",
  "version": "1.0.0",
  "key": "",
  "description": "IncogAgent Mail is a Chrome extension that provides AI-powered email summarization with privacy protection for Gmail users. This is the open source version on Github.",
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://gmail.googleapis.com/*", "<all_urls>"],
  "oauth2": {
    "client_id": "000000000000-placeholder.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "IncogAgent Mail - AI-Powered Privacy Guardian for Gmail",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ]
}